{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "vitest run",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "lint-staged": {
    "*.{js,ts,tsx,json,css,scss,md}": "biome format --write"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "express": "^5.1.0",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.7.0",
    "firebase-functions": "^7.2.0",
    "grammy": "^1.38.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "firebase-functions-test": "^3.1.0",
    "husky": "^9.1.7",
    "lint-staged": "16.2.7",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  },
  "private": true
}
